# ============================================================
# NYC Taxi Analytics Platform - .gitignore
# ============================================================

# Credentials - NEVER commit
*.json
!package.json
credentials/
secrets/
.env
.env.*
*-key.json
*-credentials.json
service-account*.json

# Data files - too large for Git
*.csv
*.parquet
*.avro
data/
*.gz
*.zip

# Python
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.pytest_cache/
*.egg-info/
dist/
build/

# IDE
.vscode/
.idea/
*.swp
*.swo
*.sublime-*

# OS
.DS_Store
Thumbs.db
desktop.ini

# Terraform
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl
crash.log
override.tf
override.tf.json
*_override.tf
*_override.tf.json
*.tfvars

# Logs
*.log
logs/

# Jupyter
.ipynb_checkpoints/

# Temporary files
tmp/
temp/
*.tmp
